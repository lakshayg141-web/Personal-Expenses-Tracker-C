
#include <stdio.h>

int main() {
    char item[30];
    float amount, total = 0;
    int n, i;

    printf("PERSONAL EXPENSE TRACKER\n");

    printf("Number of expenses: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++) {
        printf("\nExpense name: ");
        scanf("%29s", item);

        printf("Amount: Rs. ");
        scanf("%f", &amount);

        total += amount;

        printf("%s: Rs. %.2f\n", item, amount);
    }

    printf("\n----------------------");
    printf("\nTotal Expenses: Rs. %.2f", total);
    printf("\n----------------------\n");

    return 0;
}
